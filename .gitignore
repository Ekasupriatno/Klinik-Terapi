# ==============================================================================
# Environment & Secret Configurations (DO NOT COMMIT)
# ==============================================================================
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.local
*.pem
*.key
*.crt

# ==============================================================================
# Backend: Laravel Application & Runtime
# ==============================================================================
backend/vendor/
backend/node_modules/
backend/public/storage
backend/public/hot
backend/public/build/

# Laravel Storage & Uploads
backend/storage/*.key
backend/storage/logs/
backend/storage/framework/
backend/storage/app/public/
backend/storage/app/temp/

# Laravel Bootstrap Cache
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore

# Testing & Coverage Artifacts
.phpunit.result.cache
.pest.result.cache
backend/.phpunit.result.cache
backend/.pest.result.cache
backend/tests/.pest.result.cache

# Databases & SQLite Local Dumps
*.sqlite
*.sqlite-journal
backend/database/*.sqlite
*.sql
*.sql.gz

